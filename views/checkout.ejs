<%- include('partials/head', { bodyClass: 'page-checkout' }) %>
<%- include('partials/header') %>

<div class="container">
  <h1 class="page-title">Checkout</h1>
  <p class="checkout-demo-note">Demo store &mdash; no real payment is processed. Any made-up card number works (e.g. 4111 1111 1111 1111).</p>

  <% if (errors && errors.length) { %>
  <div class="form-errors">
    <strong>Please fix the following:</strong>
    <ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul>
  </div>
  <% } %>

  <form action="/checkout" method="post" id="checkout-form" novalidate>
    <div class="checkout-layout">
      <div class="checkout-main">

        <section class="checkout-section">
          <h2><span class="step-num">1</span> Contact</h2>
          <% if (!user) { %>
            <p class="checkout-signin-hint">Have an account? <a href="/login?return=/checkout">Sign in</a> for faster checkout.</p>
          <% } %>
          <div class="form-row">
            <div class="form-field">
              <label for="co-email">Email *</label>
              <input type="email" id="co-email" name="email" value="<%= form.email || '' %>" required>
            </div>
            <div class="form-field">
              <label for="co-phone">Phone</label>
              <input type="tel" id="co-phone" name="phone" value="<%= form.phone || '' %>">
            </div>
          </div>
        </section>

        <section class="checkout-section">
          <h2><span class="step-num">2</span> Shipping Address</h2>
          <div class="form-row">
            <div class="form-field">
              <label for="co-fname">First Name *</label>
              <input type="text" id="co-fname" name="firstName" value="<%= form.firstName || '' %>" required>
            </div>
            <div class="form-field">
              <label for="co-lname">Last Name *</label>
              <input type="text" id="co-lname" name="lastName" value="<%= form.lastName || '' %>" required>
            </div>
          </div>
          <div class="form-field">
            <label for="co-addr1">Street Address *</label>
            <input type="text" id="co-addr1" name="address1" value="<%= form.address1 || '' %>" required>
          </div>
          <div class="form-field">
            <label for="co-addr2">Apt / Suite (optional)</label>
            <input type="text" id="co-addr2" name="address2" value="<%= form.address2 || '' %>">
          </div>
          <div class="form-row form-row-3">
            <div class="form-field">
              <label for="co-city">City *</label>
              <input type="text" id="co-city" name="city" value="<%= form.city || '' %>" required>
            </div>
            <div class="form-field">
              <label for="co-region">Province / State *</label>
              <input type="text" id="co-region" name="region" value="<%= form.region || '' %>" required>
            </div>
            <div class="form-field">
              <label for="co-postal">Postal / ZIP *</label>
              <input type="text" id="co-postal" name="postal" value="<%= form.postal || '' %>" required>
            </div>
          </div>
          <div class="form-field">
            <label for="co-country">Country *</label>
            <select id="co-country" name="country" required>
              <option value="CA" <%= form.country === 'CA' || !form.country ? 'selected' : '' %>>Canada</option>
              <option value="US" <%= form.country === 'US' ? 'selected' : '' %>>United States</option>
            </select>
          </div>
        </section>

        <section class="checkout-section">
          <h2><span class="step-num">3</span> Shipping Method</h2>
          <label class="ship-option">
            <input type="radio" name="shippingMethod" value="standard" <%= cart.shippingMethod !== 'express' ? 'checked' : '' %>>
            <span class="ship-option-info">
              <strong>Standard</strong> <span>2&ndash;7 business days</span>
            </span>
            <span class="ship-option-price"><%= cart.subtotal - cart.discount >= 10000 ? 'FREE' : fmt(995) %></span>
          </label>
          <label class="ship-option">
            <input type="radio" name="shippingMethod" value="express" <%= cart.shippingMethod === 'express' ? 'checked' : '' %>>
            <span class="ship-option-info">
              <strong>Express</strong> <span>1&ndash;3 business days</span>
            </span>
            <span class="ship-option-price"><%= fmt(1495) %></span>
          </label>
        </section>

        <section class="checkout-section">
          <h2><span class="step-num">4</span> Payment</h2>
          <div class="form-field">
            <label for="co-ccnum">Card Number *</label>
            <input type="text" id="co-ccnum" name="ccNumber" placeholder="4111 1111 1111 1111" value="<%= form.ccNumber || '' %>" autocomplete="off" required>
          </div>
          <div class="form-row">
            <div class="form-field">
              <label for="co-ccexp">Expiry (MM/YY) *</label>
              <input type="text" id="co-ccexp" name="ccExpiry" placeholder="05/29" value="<%= form.ccExpiry || '' %>" autocomplete="off" required>
            </div>
            <div class="form-field">
              <label for="co-cccvv">CVV *</label>
              <input type="text" id="co-cccvv" name="ccCvv" placeholder="123" maxlength="4" value="" autocomplete="off" required>
            </div>
          </div>
          <p class="payment-note">&#128274; This is a demonstration checkout. Card details are validated for format only and never stored.</p>
        </section>

        <button type="submit" class="btn btn-primary btn-lg btn-block" id="place-order-btn">Place Order</button>
      </div>

      <aside class="checkout-aside">
        <div class="checkout-items">
          <h3>In Your Bag (<%= cart.itemCount %>)</h3>
          <% cart.lines.forEach(function (l) { %>
          <div class="checkout-item" data-sku="<%= l.sku %>">
            <img src="<%= l.variant.images[0] %>" alt="">
            <div class="checkout-item-info">
              <span class="checkout-item-title"><%= l.isGift ? l.product.shortName : l.product.title %><% if (l.isGift) { %> <span class="badge badge-gift">Gift</span><% } %></span>
              <span class="checkout-item-meta"><%= l.variant.colorName %> / <%= l.size %> &times; <%= l.qty %></span>
            </div>
            <span class="checkout-item-price"><% if (l.isGift) { %><span class="price-free">FREE</span><% } else { %><%= fmt(l.lineTotal) %><% } %></span>
          </div>
          <% }) %>
        </div>
        <div id="cart-summary-wrap">
          <%- include('partials/cart-summary', { cart: cart, checkoutMode: true }) %>
        </div>
      </aside>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
