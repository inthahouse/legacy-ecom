<%- include('partials/head', { bodyClass: 'page-stores' }) %>
<%- include('partials/header') %>

<div class="container">
  <h1 class="page-title">Store Finder</h1>
  <p class="stores-intro"><%= storeCount %> stores across Canada and the United States. Search by city, or use your location to find the closest one.</p>

  <div class="stores-controls">
    <input type="text" id="store-search" placeholder="Search city, store name or postal code…">
    <select id="store-country">
      <option value="">All Countries</option>
      <option value="CA">Canada</option>
      <option value="US">United States</option>
    </select>
    <select id="store-region">
      <option value="">All Provinces / States</option>
      <% regions.forEach(function (r) { %>
        <option value="<%= r.code %>" data-country="<%= r.country %>"><%= r.name %></option>
      <% }) %>
    </select>
    <button class="btn btn-primary" id="store-geolocate" type="button">Use My Location</button>
  </div>

  <div class="stores-layout">
    <div class="stores-list-wrap">
      <div class="stores-list-toolbar">
        <p class="stores-result-count" id="stores-result-count"></p>
        <div class="view-toggle" role="group" aria-label="Store view">
          <button type="button" class="view-toggle-btn js-store-view is-active" data-view="list" aria-label="List view" aria-pressed="true" title="List view">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4.5" width="4" height="4" rx="0.5"/><rect x="3" y="15.5" width="4" height="4" rx="0.5"/><line x1="10" y1="6.5" x2="21" y2="6.5"/><line x1="10" y1="17.5" x2="21" y2="17.5"/></svg>
          </button>
          <button type="button" class="view-toggle-btn js-store-view" data-view="table" aria-label="Table view" aria-pressed="false" title="Table view">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="1"/><line x1="3" y1="9.5" x2="21" y2="9.5"/><line x1="9" y1="9.5" x2="9" y2="20"/><line x1="15" y1="9.5" x2="15" y2="20"/></svg>
          </button>
        </div>
      </div>
      <div class="stores-list" id="stores-list"><!-- rendered by stores.js --></div>
    </div>
    <div class="stores-map-wrap">
      <div class="stores-map" id="stores-map">
        <!-- not a real map. lat/lng projected onto a box. the google maps
             embed was removed when the API key started billing us. -->
        <div class="map-label">CANADA</div>
        <div class="map-label map-label-us">UNITED STATES</div>
        <div id="map-pins"></div>
      </div>
      <div class="map-selected" id="map-selected"></div>
    </div>
  </div>
</div>

<script>
  var STORE_DATA = <%- JSON.stringify(stores) %>;
</script>

<%- include('partials/footer') %>
