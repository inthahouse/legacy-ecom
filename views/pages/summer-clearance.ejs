<%- include('../partials/head', { bodyClass: 'page-marketing page-clearance' }) %>
<%- include('../partials/header') %>

<div class="container">
  <section class="mkt-video-promo">
    <p class="hero-kicker">Watch</p>
    <h2 class="section-title">Summer Clearance, In Motion</h2>
    <video
      class="mkt-video-promo-media"
      src="/videos/summer-clearance.mp4"
      autoplay
      loop
      playsinline
      muted
    ></video>
  </section>
</div>

<section class="mkt-hero mkt-hero-clearance">
  <div class="container">
    <p class="hero-kicker">Final Weeks</p>
    <h1>Summer Clearance</h1>
    <p class="mkt-hero-sub">Up to 50% off select styles. When it's gone, it's gone.</p>
    <div class="countdown" id="clearance-countdown">
      <div class="cd-cell"><span id="cd-days">--</span><label>Days</label></div>
      <div class="cd-cell"><span id="cd-hours">--</span><label>Hours</label></div>
      <div class="cd-cell"><span id="cd-mins">--</span><label>Mins</label></div>
      <div class="cd-cell"><span id="cd-secs">--</span><label>Secs</label></div>
    </div>
    <a class="btn btn-light btn-lg" href="/collections/sale">Shop All Sale</a>
  </div>
</section>

<div class="container">
  <h2 class="section-title">Shop Sale by Category</h2>
  <div class="collection-cards">
    <% Object.keys(saleByCat).forEach(function (slug) { var c = saleByCat[slug]; %>
    <a class="collection-card" href="/collections/sale">
      <img src="<%= c.sample.variants[0].images[0] %>" alt="" loading="lazy">
      <div class="collection-card-info">
        <h3><%= c.name %></h3>
        <span class="collection-card-count"><%= c.count %> styles on sale</span>
      </div>
    </a>
    <% }) %>
  </div>

  <div class="mkt-fineprint">
    <p>* Discounts as marked. Sale items are final-sale in store but can be returned by mail within 30 days. Promo codes cannot be combined with clearance pricing except WELCOME10 which stacks because of a promo-engine quirk we've decided is a feature.</p>
  </div>
</div>

<script>
  // countdown to end of month. jQuery flavoured, obviously.
  $(function () {
    var end = new Date();
    end.setMonth(end.getMonth() + 1, 1);
    end.setHours(0, 0, 0, 0);
    function tick() {
      var ms = end - new Date();
      if (ms < 0) ms = 0;
      var s = Math.floor(ms / 1000);
      $('#cd-days').text(Math.floor(s / 86400));
      $('#cd-hours').text(Math.floor(s % 86400 / 3600));
      $('#cd-mins').text(Math.floor(s % 3600 / 60));
      $('#cd-secs').text(s % 60);
    }
    tick();
    setInterval(tick, 1000);
  });
</script>

<%- include('../partials/footer') %>
