<% if (results.length) { %>
<ul class="suggest-list">
  <% results.forEach(function (p) { %>
  <li>
    <a href="/products/<%= p.slug %>">
      <img src="<%= p.variants[0].images[0] %>" alt="">
      <span class="suggest-info">
        <span class="suggest-title"><%= p.title %></span>
        <span class="suggest-meta"><%= p.brand %> &middot; <%= fmt(p.price) %></span>
      </span>
    </a>
  </li>
  <% }) %>
  <li class="suggest-all"><a href="/search?q=<%= encodeURIComponent(q) %>">See all results for &ldquo;<%= q %>&rdquo; &rarr;</a></li>
</ul>
<% } else { %>
<p class="suggest-none">No matches for &ldquo;<%= q %>&rdquo;</p>
<% } %>
