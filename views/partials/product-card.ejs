<%
/* product card - expects `p`. Used by grids, carousels, wishlist, search.
   data-* attrs are read by main.js (quickview, wishlist, swatch hover).
   When the grid is colour-filtered we lead with the matching colourway -
   merch asked for this in 2019 and it's one of the few tickets we closed. */
var v0 = p.variants[0];
if (typeof result !== 'undefined' && result && result.selected && result.selected.colors && result.selected.colors.length) {
  for (var _vi = 0; _vi < p.variants.length; _vi++) {
    if (result.selected.colors.indexOf(p.variants[_vi].colorFamily) !== -1) { v0 = p.variants[_vi]; break; }
  }
}
var cardHref = '/products/' + p.slug + (v0 === p.variants[0] ? '' : '?color=' + v0.colorSlug);
%>
<div class="product-card" data-product-id="<%= p.id %>">
  <div class="card-media">
    <a href="<%= cardHref %>" class="card-img-link">
      <img class="card-img card-img-front" src="<%= v0.images[0] %>" alt="<%= p.title %>" loading="lazy">
      <img class="card-img card-img-hover" src="<%= v0.images[1] %>" alt="" loading="lazy" aria-hidden="true">
    </a>
    <div class="card-badges">
      <% if (p.onSale) { %><span class="badge badge-sale">Sale</span><% } %>
      <% if (p.isNew) { %><span class="badge badge-new">New</span><% } %>
      <% if (p.bestSeller) { %><span class="badge badge-best">Best Seller</span><% } %>
    </div>
    <button class="card-wish js-wishlist-toggle <%= wishlist.indexOf(p.id) !== -1 ? 'is-active' : '' %>"
            data-product-id="<%= p.id %>" title="Add to wishlist" type="button">
      <svg width="18" height="18" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
    </button>
    <button class="card-quickview js-quickview" data-product-id="<%= p.id %>" type="button">Quick View</button>
  </div>
  <div class="card-info">
    <div class="card-brand"><%= p.brand %></div>
    <a class="card-title" href="<%= cardHref %>"><%= p.title %></a>
    <div class="card-price">
      <% if (p.compareAt) { %>
        <span class="price price-sale"><%= fmt(p.price) %></span>
        <span class="price price-compare"><%= fmt(p.compareAt) %></span>
      <% } else { %>
        <span class="price"><%= fmt(p.price) %></span>
      <% } %>
    </div>
    <% if (p.rating > 0) { %>
    <div class="card-rating" title="<%= p.rating.toFixed(1) %> out of 5">
      <span class="stars" style="--rating: <%= (p.rating/5*100).toFixed(0) %>%;">★★★★★</span>
      <span class="rating-count">(<%= p.ratingCount %>)</span>
    </div>
    <% } %>
    <div class="card-swatches">
      <% p.variants.slice(0, 4).forEach(function (v, i) { %>
        <span class="card-swatch <%= v.colorSlug === v0.colorSlug ? 'is-active' : '' %>" style="background: <%= v.hex %>;"
              title="<%= v.colorName %>"
              data-front="<%= v.images[0] %>" data-hover="<%= v.images[1] %>"
              data-url="/products/<%= p.slug %>?color=<%= v.colorSlug %>"></span>
      <% }) %>
      <% if (p.variants.length > 4) { %>
        <a class="card-swatch-more" href="/products/<%= p.slug %>">+<%= p.variants.length - 4 %></a>
      <% } %>
    </div>
  </div>
</div>
