<%- include('partials/head', { bodyClass: 'page-auth' }) %>
<%- include('partials/header') %>

<div class="container">
  <div class="auth-box">
    <h1>Create Account</h1>
    <% if (errors && errors.length) { %>
    <div class="form-errors"><ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div>
    <% } %>

    <form action="/register" method="post">
      <div class="form-row">
        <div class="form-field">
          <label for="rg-fname">First Name</label>
          <input type="text" id="rg-fname" name="firstName" value="<%= form.firstName || '' %>" required>
        </div>
        <div class="form-field">
          <label for="rg-lname">Last Name</label>
          <input type="text" id="rg-lname" name="lastName" value="<%= form.lastName || '' %>">
        </div>
      </div>
      <div class="form-field">
        <label for="rg-email">Email</label>
        <input type="email" id="rg-email" name="email" value="<%= form.email || '' %>" required>
      </div>
      <div class="form-field">
        <label for="rg-pass">Password (6+ characters)</label>
        <input type="password" id="rg-pass" name="password" required>
      </div>
      <div class="form-field">
        <label for="rg-pass2">Confirm Password</label>
        <input type="password" id="rg-pass2" name="passwordConfirm" required>
      </div>
      <button type="submit" class="btn btn-primary btn-block btn-lg">Create Account</button>
    </form>
    <p class="auth-alt">Already have an account? <a href="/login">Sign in</a></p>
  </div>
</div>

<%- include('partials/footer') %>
